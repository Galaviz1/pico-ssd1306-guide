{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run on Pico",
      "type": "shell",
      "command": "python3 -m mpremote connect auto run \"${file}\"",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Copy file to Pico",
      "type": "shell",
      "command": "python3 -m mpremote connect auto cp \"${file}\" :",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "List files on Pico",
      "type": "shell",
      "command": "python3 -m mpremote connect auto ls",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Open Pico REPL",
      "type": "shell",
      "command": "python3 -m mpremote connect auto repl",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
